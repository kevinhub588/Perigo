local function mkBtn(text, color, xPos, width)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(width, -5, 1, 0); b.Position = UDim2.new(xPos, 0, 0, 0)
    b.BackgroundColor3 = color:Lerp(Color3.new(0,0,0), 0.78)
    b.Text = text; b.TextColor3 = color
    b.TextSize = 11; b.Font = Enum.Font.GothamBold; b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = ButtonContainer

    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 5); corner.Parent = b

    local st = Instance.new("UIStroke")
    st.Color = color; st.Thickness = 1.4; st.Transparency = 0.1; st.Parent = b

    local glow = Instance.new("UIStroke")
    glow.Color = color; glow.Thickness = 3; glow.Transparency = 0.7; glow.Parent = b

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, color:Lerp(Color3.new(1,1,1), 0.15):Lerp(Color3.new(0,0,0), 0.6)),
        ColorSequenceKeypoint.new(1, color:Lerp(Color3.new(0,0,0), 0.88)),
    }
    grad.Rotation = 90
    grad.Parent = b

    b.MouseEnter:Connect(function()
        tw(st, { Thickness = 2, Transparency = 0 }, 0.12)
        tw(glow, { Transparency = 0.35 }, 0.12)
        tw(b, { BackgroundColor3 = color:Lerp(Color3.new(0,0,0), 0.55), TextColor3 = Color3.new(1,1,1) }, 0.12)
    end)
    b.MouseLeave:Connect(function()
        tw(st, { Thickness = 1.4, Transparency = 0.1 }, 0.15)
        tw(glow, { Transparency = 0.7 }, 0.15)
        tw(b, { BackgroundColor3 = color:Lerp(Color3.new(0,0,0), 0.78), TextColor3 = color }, 0.15)
    end)
    b.MouseButton1Down:Connect(function()
        tw(b, { BackgroundColor3 = color:Lerp(Color3.new(0,0,0), 0.42) }, 0.06)
    end)
    b.MouseButton1Up:Connect(function()
        tw(b, { BackgroundColor3 = color:Lerp(Color3.new(0,0,0), 0.55) }, 0.1)
    end)

    return b
end

