local originalLoadstring = loadstring
local originalLoad = load

GetBtn.MouseButton1Click:Connect(function()
    local txt = InputBox.Text
    if txt == "" then
        setScrollText("[!] Cole um loadstring primeiro.")
        return
    end

    setScrollText("[...] Executando loadstring e interceptando source...")

    local capturedSource = nil

    getfenv().loadstring = function(src, chunkname)
        if type(src) == "string" and #src > 0 then
            capturedSource = src
            setScrollText(src)
        end
        return originalLoadstring(src, chunkname)
    end

    getfenv().load = function(chunk, chunkname, mode, env)
        if type(chunk) == "string" and #chunk > 0 then
            capturedSource = chunk
            setScrollText(chunk)
        end
        return originalLoad(chunk, chunkname, mode, env)
    end

    local success, err = pcall(function()
        local fn = originalLoadstring(txt, "user_loader")
        if not fn then
            error("Loadstring invalido")
        end
        fn()
    end)

    getfenv().loadstring = originalLoadstring
    getfenv().load = originalLoad

    if capturedSource then
        setScrollText(capturedSource)
    else
        if success then
            setScrollText("[!] O loadstring executou mas nao chamou loadstring/load com uma string.\n\n" ..
                "Isso acontece quando o script usa game:HttpGet direto e executa o retorno,\n" ..
                "ou quando o codigo ja estava compilado em bytecode.")
        else
            setScrollText("[X] Erro ao executar: " .. tostring(err))
        end
    end
end)

