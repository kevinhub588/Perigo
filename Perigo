-- helper de tween enxuto
local function tw(obj, props, t, style, dir, rep, rev)
    local info = TweenInfo.new(
        t or 0.15,
        style or Enum.EasingStyle.Quad,
        dir or Enum.EasingDirection.Out,
        rep or 0,
        rev or false
    )
    local tn = TweenService:Create(obj, info, props)
    tn:Play()
    return tn
end

